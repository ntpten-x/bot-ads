{
  "manifest_version": 3,
  "name": "Meta Ads Data Collector",
  "version": "0.6.73",
  "description": "Collect reports and control Meta Business Suite through visible web UI. No Meta API integration.",
  "permissions": ["activeTab", "scripting", "storage", "alarms", "debugger"],
  "optional_host_permissions": [
    "https://adsmanager.facebook.com/*",
    "https://business.facebook.com/*"
  ],
  "host_permissions": ["http://127.0.0.1:4318/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meta Ads Data Collector"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:4318"
  }
}
